# Расписание для office-runner.service.
#
# Расписание держит таймер, а не цикл внутри процесса: планировщик уже умеет это,
# и дублировать его незачем. Команда `runner loop` нужна там, где планировщика нет.

[Unit]
Description=Виртуальный офис: цикл раннера каждые две минуты

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
# Пропущенные из-за выключения запуски не копятся: догонять очередь незачем.
Persistent=false

[Install]
WantedBy=timers.target
