#!/bin/sh
# Точка входа ручного запуска агента.
#
# Обёртка нужна ровно для двух вещей: сообщить раннеру каталог офиса в клоне
# и запомнить каталог, из которого её позвали, — чтобы относительные --workdir
# и --task не поехали после перехода в корень.
#
# Как и bin/runner: сборка плюс exec вместо `go run`, который держит бинарник
# потомком и не передаёт ему сигналов; имя run-agent-dev — чтобы не писать
# поверх ${OFFICE_HOME}/bin/run-agent, который кладёт install.sh.

set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
OFFICE_CONFIG_ROOT="$repo/office"
OFFICE_INVOCATION_DIR=$PWD
export OFFICE_CONFIG_ROOT OFFICE_INVOCATION_DIR

bin="${OFFICE_HOME:-$HOME/.office}/bin"
mkdir -p "$bin"

cd "$repo"
go build -o "$bin/run-agent-dev" ./cmd/run-agent
exec "$bin/run-agent-dev" "$@"
