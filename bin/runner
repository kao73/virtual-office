#!/bin/sh
# Точка входа раннера.
#
# Обёртка сообщает раннеру корень конфиг-репозитория — оттуда он берёт роли,
# workflow.yaml и роли — и запоминает каталог вызова, чтобы
# относительные пути в аргументах не поехали после перехода в корень.
#
# Вторая половина конфигурации лежит в ${OFFICE_HOME} и обёртке не нужна: путь
# к хозяйству раннер знает сам. Что именно он взял и откуда, он печатает при старте.
#
# Собирается бинарник и запускается через exec, а не через `go run`. Причина
# измерена: `go run` исполняет собранный бинарник **потомком** и сигналы ему
# не передаёт. SIGTERM обёртке убивал только её, а раннер оставался сиротой
# с родителем 1 и работал дальше — под launchd, systemd или cron это означало бы
# накопление живых прогонов, которых никто не остановит. После exec процесс один,
# и сигнал приходит прямо ему.

set -eu

OFFICE_CONFIG_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
OFFICE_INVOCATION_DIR=$PWD
export OFFICE_CONFIG_ROOT OFFICE_INVOCATION_DIR

bin="${OFFICE_HOME:-$HOME/.office}/bin"
mkdir -p "$bin"

cd "$OFFICE_CONFIG_ROOT"
go build -o "$bin/runner" ./cmd/runner
exec "$bin/runner" "$@"
